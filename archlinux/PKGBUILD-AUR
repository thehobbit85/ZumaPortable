# Maintainer: abduznik <abduznik@users.noreply.github.com>

pkgname=zuma-portable
pkgver=0.0.0
pkgrel=1
pkgdesc="Source port of Zuma Deluxe built on SDL2 (engine only - bring your own game files)"
url="https://github.com/abduznik/${pkgname}"
arch=('x86_64' 'aarch64')
license=('LGPL-3.0-or-later')
depends=(
    glibc
    libgcc
    libjpeg-turbo
    libopenmpt
    libpng
    libstdc++
    sdl2-compat
    zlib
)
makedepends=(
    cmake
    git
    ninja
)
source=(
    "${pkgname}::git+${url}.git#tag=${pkgver}"
    "zuma-portable.sh"
    "zuma-portable.desktop"
)
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

pkgver() {
    cd "${pkgname}"
    git describe --tags --abbrev=12 | sed 's/^v//;s/-/./g'
}

build() {
    cmake -G Ninja -B build -S "${pkgname}" \
        -DCMAKE_BUILD_TYPE='Release' \
        -DCMAKE_INSTALL_PREFIX='/usr'
    cmake --build build
}

package() {
    # Engine only. Game data (properties/, images/, sounds/, levels/, music/,
    # fonts/) is NOT packaged - the launcher reads it from the user's home.
    install -Dm755 "build/zuma-portable" "${pkgdir}/usr/share/zuma-portable/zuma-portable"
    install -Dm755 "zuma-portable.sh" "${pkgdir}/usr/bin/zuma-portable"

    install -Dm644 "${pkgname}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 "${pkgname}/COPYING" "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
    install -Dm644 "zuma-portable.desktop" "${pkgdir}/usr/share/applications/zuma-portable.desktop"
    install -Dm644 "${pkgname}/icon.png" "${pkgdir}/usr/share/pixmaps/zuma-portable.png"
}

post_install() {
    cat <<'EOF'
Zuma Deluxe Portable is installed, but it ships no game data.

Copy the contents of your legally purchased Zuma Deluxe folder
(properties/, images/, sounds/, levels/, music/, fonts/) into:

    ~/.local/share/zuma-portable/

Then run `zuma-portable`.
EOF
}
